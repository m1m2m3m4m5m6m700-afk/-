{
  "name": "flixo-tools",
  "private": true,
  "type": "module",
  "engines": {"node": "22.x"},
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "generate:routes": "vite build --mode development",
    "start": "node .output/server/index.mjs",
    "pretypecheck": "npm run generate:routes",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "validate:project-contract": "node src/scripts/validate-project-contract.mjs",
    "validate:test-quality": "node src/scripts/validate-test-quality.mjs",
    "test:property-fuzz": "node src/scripts/test-property-fuzz.mjs",
    "test:fault-injection": "node src/scripts/test-fault-injection.mjs",
    "test:mutation": "node src/scripts/test-mutation.mjs",
    "validate:security-strict": "node src/scripts/strict-security.mjs",
    "validate:flaky-isolation": "node src/scripts/strict-flaky-isolation.mjs",
    "validate:failure-quality": "node src/scripts/strict-failure-quality.mjs",
    "validate:performance": "node src/scripts/strict-performance.mjs",
    "validate:foundation": "npm run validate:project-contract && npm run validate:test-quality && npm run validate:tool-platform && npm run validate:tool-platform-lifecycle && npm run validate:tool-platform-boundaries && npm run typecheck && npm run lint && npm run build && npm run validate:route-tree && npm run validate:flaky-isolation && npm run validate:failure-quality && npm run validate:security-strict && npm run test:property-fuzz && npm run test:fault-injection && npm run audit:production",
    "verify:foundation": "npm run validate:foundation",
    "verify:tool": "npm run verify:foundation && npm run validate:tool-platform-regression && npm run test:desktop",
    "verify:strict": "npm run verify:foundation && npm run validate:performance",
    "verify:project": "npm run verify:strict && npm run verify:tool",
    "verify": "npm run verify:project && npm run test && npm run audit:production",
    "test:e2e": "playwright test tests/pdf-tools.spec.ts tests/desktop-tools.spec.ts tests/chat.spec.ts tests/accessibility.spec.ts",
    "test": "npm run validate:registry && npm run validate:tool-runtime && npm run validate:search-catalog && npm run validate:seo && npm run validate:tool-content && npm run validate:localization && npm run validate:localization-surface && npm run validate:tool-content-localization && npm run validate:pdf-catalog && npm run validate:tool-review && npm run validate:ai && npm run validate:search-intent && npm run validate:accessibility && npm run validate:security && npm run typecheck && npm run lint && npm run test:e2e && npm run test:build",
    "test:build": "npm run build && node src/scripts/validate-build-output.mjs",
    "test:pdf": "playwright test tests/pdf-tools.spec.ts",
    "test:desktop": "playwright test tests/desktop-tools.spec.ts",
    "test:desktop:flaky": "playwright test tests/desktop-tools.spec.ts --repeat-each=3",
    "test:chat": "playwright test tests/chat.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:certification-baseline": "node --test tests/certification/validate-baseline.test.mjs",
    "validate-ci-contract": "node scripts/validate-ci-contract.mjs",
    "validate:dependencies": "node scripts/validate-dependency-contract.mjs",
    "validate:registry": "node src/scripts/validate-registry.mjs",
    "validate:tool-runtime": "node src/scripts/validate-tool-runtime.mjs",
    "validate:tool-platform": "node src/scripts/validate-tool-platform.mjs",
    "validate:tool-platform-lifecycle": "node src/scripts/validate-tool-platform-lifecycle.mjs",
    "validate:tool-platform-boundaries": "node src/scripts/validate-tool-platform-boundaries.mjs",
    "validate:tool-platform-regression": "node src/scripts/validate-tool-platform-regression.mjs",
    "validate:search-catalog": "node src/scripts/validate-search-catalog.mjs",
    "validate:pdf-catalog": "node src/scripts/validate-pdf-catalog.mjs",
    "validate:tool-review": "node src/scripts/validate-tool-review.mjs",
    "validate:ai": "node src/scripts/validate-ai-contract.mjs",
    "validate:accessibility": "node src/scripts/validate-accessibility-contract.mjs",
    "validate:security": "node src/scripts/validate-security-contract.mjs",
    "generate:seo": "node src/scripts/generate-static-seo.mjs",
    "validate:seo": "node src/scripts/validate-seo.mjs",
    "validate:route-tree": "node src/scripts/validate-route-tree.mjs",
    "validate:tool-content": "node src/scripts/validate-tool-content.mjs",
    "validate:localization": "node src/scripts/validate-localization.mjs",
    "validate:localization-surface": "node src/scripts/validate-localization-surface.mjs",
    "report:localization": "node scripts/report-localization.mjs",
    "validate:search-intent": "node src/scripts/validate-search-intent.mjs",
    "validate:tool-content-localization": "node src/scripts/validate-tool-content-localization.mjs",
    "localization:baseline": "npm run validate:localization -- --update-baseline",
    "localization:content-approve": "npm run validate:tool-content-localization -- --update-state",
    "agent:status": "node src/scripts/flixo-agent.mjs --task=status",
    "agent:docs": "node src/scripts/flixo-agent.mjs --task=docs",
    "agent:health": "node src/scripts/flixo-agent.mjs --task=health",
    "agent:localization": "node src/scripts/flixo-agent.mjs --task=localization",
    "agent:report": "node src/scripts/flixo-agent.mjs --task=report",
    "patch": "node scripts/patch-and-sync.mjs patch",
    "sync": "node scripts/patch-and-sync.mjs sync",
    "push": "node scripts/patch-and-sync.mjs push",
    "status": "node scripts/patch-and-sync.mjs status",
    "patch-all": "node scripts/patch-and-sync.mjs all"
  }
}