{
  "name": "flixo-tools",
  "private": true,
  "type": "module",
  "engines": {"node": "22.x"},
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fast": "npx --yes @biomejs/biome@2.5.9 lint .",
    "format:check": "prettier --check .",
    "format:fast": "npx --yes @biomejs/biome@2.5.9 format .",
    "format:fix": "npx --yes @biomejs/biome@2.5.9 format --write .",
    "maintenance:fast": "npx --yes @biomejs/biome@2.5.9 check . && npx --yes knip@6.31.0",
    "dead-code": "npx --yes knip@6.31.0",
    "dead-code:fix": "npx --yes knip@6.31.0 --fix",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "preflight": "node scripts/preflight-integrity.mjs",
    "verify:routes": "node scripts/verify-route-contracts.mjs",
    "test:unit": "node --test scripts/intent-normalize.test.mjs",
    "detect:anomalies": "node scripts/detect-error-anomalies.mjs",
    "test:mutation": "npx --yes @stryker-mutator/core@10.0.0 run --configFile=stryker.config.json",
    "canary:check": "node scripts/canary-check.mjs",
    "check": "npm run preflight && npm run verify:routes && npm run test:unit && npm run detect:anomalies && npm run typecheck && npm run lint && npm run build",
    "test:e2e": "playwright test",
    "verify:baseline": "node scripts/validate-engineering-baseline.mjs",
    "verify": "npm run verify:baseline && npm run check",
    "test": "npm run verify && npm run test:e2e"
  },
