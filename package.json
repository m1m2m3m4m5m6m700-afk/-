{
  "name": "flixo-tools",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "generate:routes": "npx --yes @tanstack/router-cli@1.167.21 generate",
    "generate:seo": "node src/scripts/generate-static-seo.mjs",
    "build": "npm run generate:seo && npm run generate:routes && vite build",
    "build:dev": "vite build --mode development",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run test && npm run audit:production",
    "test": "npm run validate:registry && npm run validate:tool-runtime && npm run validate:seo && npm run validate:tool-content && npm run validate:localization && npm run validate:search-intent && npm run validate:tool-content-localization && npm run test:truthfulness && npm run typecheck && npm run lint && npm run test:build",
    "test:truthfulness": "node src/scripts/validate-truthfulness.mjs",
    "test:build": "npm run build && node src/scripts/validate-build-output.mjs",
    "validate:registry": "node src/scripts/validate-registry.mjs",
    "validate:tool-runtime": "node src/scripts/validate-tool-runtime.mjs",
    "validate:route-tree": "node src/scripts/validate-route-tree.mjs",
    "validate:tool-content": "node src/scripts/validate-tool-content.mjs",
    "validate:localization": "node src/scripts/validate-localization.mjs",
    "validate:search-intent": "node src/scripts/validate-search-intent.mjs",
    "validate:tool-content-localization": "node src/scripts/validate-tool-content-localization.mjs",
    "localization:baseline": "node src/scripts/validate-localization.mjs --update-baseline",
    "localization:content-approve": "node src/scripts/validate-tool-content-localization.mjs --update-state",
    "agent:status": "node src/scripts/flixo-agent.mjs --task=status",
    "agent:docs": "node src/scripts/flixo-agent.mjs --task=docs",
    "agent:health": "node src/scripts/flixo-agent.mjs --task=health",
    "agent:report": "node src/scripts/flixo-agent.mjs --task=report",
    "patch": "node scripts/patch-and-sync.mjs patch",
    "sync": "node scripts/patch-and-sync.mjs sync",
    "push": "node scripts/patch-and-sync.mjs push",
    "status": "node scripts/patch-and-sync.mjs status",
    "patch-all": "node scripts/patch-and-sync.mjs all"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "@tanstack/router-plugin": "1.168.23",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "gif.js": "^0.2.0",
    "gifuct-js": "^2.1.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.9",
    "motion": "^12.43.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "@tanstack/react-router": "1.170.18",
    "@tanstack/router-core": "1.171.15",
    "image-size": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lovable.dev/vite-tanstack-config": "2.9.1",
    "@types/gif.js": "^0.2.5",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.62.1",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.5"
  }
}
