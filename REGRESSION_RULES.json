{
  "version": 2,
  "rules": [
    {"id":"no-focused-tests","pattern":"\\b(?:test|it|describe)\\.only\\s*\\(","flags":"g","guardMode":"critical"},
    {"id":"no-ts-ignore","pattern":"@ts-(?:ignore|nocheck)","flags":"g","guardMode":"critical","pathPrefixes":["src/scripts/"]},
    {"id":"no-console-log","pattern":"\\bconsole\\.log\\s*\\(","flags":"g","guardMode":"advisory"},
    {"id":"no-secret-env-literals","pattern":"(?:password|secret|token|api[_-]?key)\\s*[:=]\\s*[\"'][^\"']{12,}[\"']","flags":"gi","guardMode":"critical"}
  ]
}
