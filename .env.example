ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
FLIXO_AI_DEFAULT_MAX_TOKENS=
FLIXO_AI_MAX_INPUT_CHARS=
# Free-first AI routing. Default is true: local Ollama, then configured Gemini/Groq, then explicit paid OpenAI only when selected.
FLIXO_AI_FREE_FIRST=true
# Optional explicit provider override: ollama | gemini | groq | openai
FLIXO_AI_PROVIDER=
# Optional explicit single fallback provider. Free-first mode otherwise uses configured free providers in order.
FLIXO_AI_FALLBACK_PROVIDER=
FLIXO_AI_TIMEOUT_MS=
GITHUB_APP_CALLBACK_URL=
GITHUB_BRANCH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# ---- Gemini Free Tier ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---- Groq ----
# Use a Groq API key and the open-weight GPT-OSS 20B model for a strong low-cost/free-tier path.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Local Ollama ----
# Used when Flixo is self-hosted on the same machine/network as Ollama.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

VITE_ANALYTICS_DEBUG=
VITE_CLARITY_PROJECT_ID=
VITE_ENABLE_ANALYTICS=
VITE_GA_MEASUREMENT_ID=

DATABASE_URL=
DATABASE_POOL_MAX_CONNECTIONS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
