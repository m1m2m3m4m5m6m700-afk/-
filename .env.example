ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
FLIXO_AI_DEFAULT_MAX_TOKENS=
FLIXO_AI_MAX_INPUT_CHARS=
# Which AI provider the AI task pipeline + chatbot use. "openai" (default), "gemini", or "openrouter".
FLIXO_AI_PROVIDER=
FLIXO_AI_FALLBACK_PROVIDER=
FLIXO_AI_TIMEOUT_MS=
GITHUB_APP_CALLBACK_URL=
GITHUB_BRANCH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# ---- OpenRouter — optional server-side fallback/provider.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ---- Gemini (Free Tier) — powers the Flixo chatbot when FLIXO_AI_PROVIDER=gemini.
# Server-side only. Never expose this key through VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
VITE_ANALYTICS_DEBUG=
VITE_CLARITY_PROJECT_ID=
VITE_ENABLE_ANALYTICS=
VITE_GA_MEASUREMENT_ID=

# ---- Phase 3: Postgres persistence (completable-later; app runs without these) ----
# When set, the inbox/analytics/tool-requests are persisted to Postgres via
# Drizzle ORM. When unset, the RPCs return a real db_not_configured failure
# and the UI shows empty data (never fabricated). Read by src/lib/server/db/config.ts.
# `DATABASE_URL` is the canonical name (auto-provisioned by Vercel/Neon/Render);
# `POSTGRES_URL` is accepted as a legacy alias.
DATABASE_URL=
DATABASE_POOL_MAX_CONNECTIONS=

# ---- Phase 3: Email notifications (best-effort) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
