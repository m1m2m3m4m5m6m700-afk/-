ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
FLIXO_AI_DEFAULT_MAX_TOKENS=
FLIXO_AI_MAX_INPUT_CHARS=
# Which AI provider the AI task pipeline + chatbot use. "openai" (default) or
# "gemini". When "gemini", the FlixoChatWidget and AI tools call Google's
# Generative Language API (server-side only). See src/lib/ai/config.ts.
FLIXO_AI_PROVIDER=
FLIXO_AI_TIMEOUT_MS=
GITHUB_APP_CALLBACK_URL=
GITHUB_BRANCH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
# ---- Gemini (Free Tier) — powers the Flixo chatbot when FLIXO_AI_PROVIDER=gemini.
# Completable-later: the app builds & runs without this; the chatbot surfaces a
# clear "not configured" message when unset (never a fake reply). Read server-side
# only in src/lib/ai/config.ts + src/lib/ai/chat/handler.ts; never in the client bundle.
GEMINI_API_KEY=
# Optional overrides for the Gemini provider (defaults shown).
GEMINI_MODEL=
GEMINI_BASE_URL=
VITE_ANALYTICS_DEBUG=
VITE_CLARITY_PROJECT_ID=
VITE_ENABLE_ANALYTICS=
VITE_GA_MEASUREMENT_ID=

# ---- Phase 3: Postgres persistence (completable-later; app runs without these) ----
# When set, the inbox/analytics/tool-requests are persisted to Postgres via
# Drizzle ORM. When unset, the RPCs return a real db_not_configured failure
# and the UI shows empty data (never fabricated). Read by src/lib/server/db/config.ts.
# `DATABASE_URL` is the canonical name (auto-provisioned by Vercel/Neon/Render);
# `POSTGRES_URL` is accepted as a legacy alias.
DATABASE_URL=
# Max concurrent DB connections in the lazy pool (optional, default 10).
DATABASE_POOL_MAX_CONNECTIONS=

# ---- Phase 3: Email notifications (completable-later; best-effort) ----
# When set, new visitor messages + tool requests email the site owner. When
# unset, notifications are skipped (the DB write still succeeds). Read by
# src/lib/email/config.ts.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
