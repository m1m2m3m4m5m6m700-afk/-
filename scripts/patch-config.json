{
  "project": {
    "name": "Flixo Tools",
    "repo": "m1m2m3m4m5m6m700-afk/flixotoolscom"
  },
  "patch": {
    "autoFormat": true,
    "autoLint": true,
    "updateDocs": false
  },
  "sync": {
    "baseBranch": "main",
    "remote": "origin",
    "autoPush": false,
    "createPR": true,
    "verifyBeforePush": true
  },
  "files": {
    "include": ["src/**/*.{ts,tsx,js,jsx,mjs}", "public/**/*", "*.{json,md}"],
    "exclude": ["node_modules/**", "dist/**", ".output/**", "*.log"]
  },
  "hooks": {
    "preCommit": ["npm run verify"],
    "postCommit": []
  }
}
