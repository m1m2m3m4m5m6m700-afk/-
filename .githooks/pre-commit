#!/bin/sh
set -eu

# Never mutate or block CI-side commits. Server-side self-heal has its own policy.
if [ "${CI:-false}" = "true" ] || [ "${FLIXO_PREFLIGHT_SKIP:-0}" = "1" ]; then
  exit 0
fi

branch="$(git branch --show-current)"
if [ "$branch" != "experimental" ]; then
  echo "FLIXO Preflight: non-experimental branch detected; no automatic repair will run."
  exit 0
fi

echo "FLIXO Preflight Guardian: V3 diagnose -> V4 guarded repair -> local gates"
npm run preflight:repair
