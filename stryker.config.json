{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test scripts/intent-normalize.test.mjs"
  },
  "mutate": [
    "src/lib/intent/normalize.ts"
  ],
  "reporters": ["clear-text", "json", "html"],
  "coverageAnalysis": "off",
  "tempDirName": ".stryker",
  "incremental": true,
  "concurrency": 2,
  "timeoutMS": 10000,
  "cleanTempDir": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}
